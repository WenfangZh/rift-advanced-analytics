# Riot API key from https://developer.riotgames.com (dev keys expire every 24h)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional settings (defaults shown)
# RIFT_DATA_DIR=data
# RIFT_PLATFORM=euw1
# RIFT_REGION=europe
# Rate limit windows per routing value, "limit:seconds,..." (dev/personal key default)
# RIFT_RATE_LIMITS=20:1,100:120
# RIFT_MAX_RETRIES=5
# RIFT_RANK_TTL_HOURS=24
# RIFT_MASTERY_TTL_HOURS=72
# RIFT_PLAYER_RECRAWL_HOURS=24
# RIFT_MATCHES_PER_PLAYER=20
# RIFT_DIAMOND_PAGES_PER_SEED=1
# RIFT_CONCURRENCY=4
# Only fetch matches that started after this epoch second (e.g. a season/patch start)
# RIFT_MATCH_START_TIME=
